{
  "realm": "catp",
  "enabled": true,
  "displayName": "ЦАТ — цифровой аналитик трасс подключения",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "catp-admin",
        "description": "Администратор сервиса: правила, журнал, расчёты"
      },
      {
        "name": "catp-engineer",
        "description": "Инженер: запуск расчётов и просмотр результатов"
      },
      {
        "name": "catp-viewer",
        "description": "Наблюдатель: только просмотр результатов и журнала"
      }
    ]
  },
  "clients": [
    {
      "clientId": "catp-web",
      "name": "Веб-интерфейс ЦАТ",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-catp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "catp-web",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.catp",
      "enabled": true,
      "firstName": "Администратор",
      "lastName": "Сервиса",
      "email": "admin.catp@example.org",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "catp2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "catp-admin"
      ]
    },
    {
      "username": "engineer",
      "enabled": true,
      "firstName": "Инженер",
      "lastName": "Теплосетей",
      "email": "engineer@example.org",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "catp2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "catp-engineer"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "firstName": "Наблюдатель",
      "lastName": "ДИТ",
      "email": "viewer@example.org",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "catp2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "catp-viewer"
      ]
    }
  ]
}